{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/extract-boq.js": {
      "includeFiles": "node_modules/{pdfjs-dist,pdf-parse}/**"
    },
    "api/telegram-webhook.js": {
      "memory": 1536
    },
    "api/generate-pdf-report.js": {
      "memory": 1536,
      "maxDuration": 60
    }
  }
}