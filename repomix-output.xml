<file path="src/routes/_authenticated/audit.tsx">
import { downloadAuditExcel } from "@/utils/download";
import { createFileRoute } from "@tanstack/react-router";
import { useState, useRef } from "react";
import { supabase } from "@/integrations/supabase/client";
import { insertAudit, dispatchAuditsUpdated } from "@/integrations/supabase/audits";
import {
  UploadCloud, Loader2, FileText, X, AlertCircle, CheckCircle2, 
  XCircle, AlertTriangle, RotateCcw, Search, ShieldAlert, 
  Activity, Calculator, HardHat, Scale, TrendingUp
} from "lucide-react";

import logo from "../../assets/logo.png";

export const Route = createFileRoute("/_authenticated/audit")({
  component: AuditPage,
});

type AuditResult = {
  risk_score: number;
  recommendation: string;
  executive_summary: string;
  technical_critique: string;
  arithmetic_errors: Array<{ location: string; description: string; severity: string }>;
  contractual_traps: Array<{ clause_type: string; severity: string; description: string }>;
  market_variance: Array<{ item: string; variance_pct: number; note: string }>;
  resource_gap_analysis: string;
  regulatory_compliance: string;
  project_name: string;
  contract_value: number;
  target_margin: number;
};

function riskColor(score: number) {
  if (score < 35) return { text: "text-emerald-600", bg: "bg-emerald-50", border: "border-emerald-200", bar: "bg-emerald-500" };
  if (score < 65) return { text: "text-amber-600",   bg: "bg-amber-50",   border: "border-amber-200",   bar: "bg-amber-500"   };
  return             { text: "text-red-600",          bg: "bg-red-50",     border: "border-red-200",     bar: "bg-red-500"     };
}

function RecBadge({ rec }: { rec?: string }) {
  const s = rec || "PROCEED_WITH_CAUTION";
  const label = s.replace(/_/g, ' ');
  if (s === "PROCEED") return <span className="badge badge-green"><CheckCircle2 size={12}/> {label}</span>;
  if (s === "DECLINE") return <span className="badge badge-red"><XCircle size={12}/> {label}</span>;
  return <span className="badge badge-amber"><AlertTriangle size={12}/> {label}</span>;
}

function ResultsPanel({ result, onReset }: { result: AuditResult; onReset: () => void }) {
  const risk = riskColor(result.risk_score || 0);

  return (
    <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <div className="flex justify-between items-center">
        <div>
          <p className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Forensic Audit Complete</p>
          <h2 className="text-xl font-black text-slate-900">{result.project_name}</h2>
        </div>
        <div className="flex gap-2">
          <button onClick={() => downloadAuditExcel(result)} className="btn-primary">
            <FileText size={14}/> Export Professional Excel
          </button>
          <button onClick={onReset} className="btn-ghost">Reset</button>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className={`panel p-6 ${risk.bg} ${risk.border}`}>
          <p className="section-label">Risk Index</p>
          <div className={`text-5xl font-black ${risk.text}`}>{result.risk_score}/100</div>
          <div className="mt-4"><RecBadge rec={result.recommendation} /></div>
        </div>
        <div className="md:col-span-2 panel p-6 bg-white flex flex-col justify-center gap-4">
          <div className="grid grid-cols-2 gap-4">
            <div><p className="text-[10px] font-bold text-slate-400 uppercase">Value</p><p className="font-black text-lg">{(result.contract_value || 0).toLocaleString()} ETB</p></div>
            <div><p className="text-[10px] font-bold text-slate-400 uppercase">Margin</p><p className="font-black text-lg">{result.target_margin}%</p></div>
          </div>
          <div className="pt-4 border-t border-slate-100">
            <p className="text-[11px] text-slate-500 leading-relaxed font-medium">
                <TrendingUp size={12} className="inline mr-1 text-blue-600"/> {result.executive_summary}
            </p>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div className="panel p-6 border-l-4 border-l-blue-600 shadow-sm">
          <h4 className="section-label flex items-center gap-2"><HardHat size={16} className="text-blue-600"/> Methodology Critique</h4>
          <p className="mt-3 text-[12px] text-slate-600 leading-relaxed">{result.technical_critique}</p>
        </div>

        <div className="panel p-6 border-l-4 border-l-indigo-600 shadow-sm">
          <h4 className="section-label flex items-center gap-2"><Activity size={16} className="text-indigo-600"/> Resource Adequacy</h4>
          <p className="mt-3 text-[12px] text-slate-600 leading-relaxed">{result.resource_gap_analysis}</p>
        </div>

        <div className="panel p-5">
           <h4 className="section-label flex items-center gap-2 text-red-600"><Scale size={16}/> Legal & FIDIC Traps</h4>
           <div className="mt-4 space-y-2">
             {result.contractual_traps?.map((t, i) => (
               <div key={i} className="bg-red-50/50 border border-red-100 p-3 rounded">
                 <span className="font-black text-[10px] text-red-700 block uppercase">{t.clause_type} ({t.severity})</span>
                 <p className="text-[11px] text-slate-600 mt-1">{t.description}</p>
               </div>
             ))}
           </div>
        </div>

        <div className="panel p-5">
           <h4 className="section-label flex items-center gap-2 text-amber-600"><Calculator size={16}/> Market Calibration</h4>
           <div className="mt-4 space-y-2">
             {result.market_variance?.map((m, i) => (
               <div key={i} className="flex justify-between items-center text-[11px] p-2 bg-amber-50 rounded border border-amber-100">
                 <span className="font-bold text-slate-700">{m.item}</span>
                 <span className="text-amber-700 font-bold">{m.variance_pct > 0 ? '+' : ''}{m.variance_pct}%</span>
               </div>
             ))}
           </div>
        </div>
      </div>
      
      <div className="panel p-4 bg-[#0F2240] text-slate-300">
         <p className="text-[10px] font-black uppercase tracking-widest flex items-center gap-2 text-blue-400 mb-2">
           <ShieldAlert size={12}/> Regulatory & Compliance
         </p>
         <p className="text-[11px] leading-relaxed italic">"{result.regulatory_compliance}"</p>
      </div>
    </div>
  );
}

function AuditPage() {
  const [files, setFiles] = useState<File[]>([]);
  const [projectName, setProjectName] = useState("");
  const [contractValue, setContractValue] = useState("");
  const [targetMargin, setTargetMargin] = useState("15.0");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [result, setResult] = useState<AuditResult | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const runAudit = async () => {
    if (!projectName || !contractValue) return setError("Missing required fields.");
    setLoading(true); setError(null);

    try {
      const apiKey = import.meta.env.VITE_GROQ_API_KEY;
      const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Authorization": `Bearer ${apiKey}` },
        body: JSON.stringify({
          model: "llama-3.3-70b-versatile",
          temperature: 0.2,
          response_format: { type: "json_object" },
          messages: [
            { 
              role: "system", 
              content: `You are VLT-Core Forensic Auditor. Analyze the bid and return deep forensic insights including plant adequacy and methodology critiques. 
              Output MUST be raw JSON only. 
              Structure: {
                "risk_score": integer, "recommendation": "string", "executive_summary": "string",
                "technical_critique": "string", "arithmetic_errors": [], "contractual_traps": [],
                "market_variance": [], "resource_gap_analysis": "string", "regulatory_compliance": "string"
              }`
            },
            { role: "user", content: `Audit: ${projectName}, Value: ${contractValue} ETB, Margin: ${targetMargin}%, Files: ${files.map(f=>f.name).join(', ')}` }
          ]
        })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error?.message || "API Error");
      
      const analysis = JSON.parse(data.choices[0].message.content.replace(/```json/g, "").replace(/```/g, ""));

      // Standardize risk score to Integer for Supabase
      let score = Number(analysis.risk_score || 0);
      if (score > 0 && score < 1) score = score * 100;
      const finalScore = Math.round(score);

      const { data: { user } } = await supabase.auth.getUser();
      if (user) {
        await insertAudit({
          user_id: user.id, project_name: projectName,
          file_name: files.map(f => f.name).join(" | ") || "Manual Entry",
          contract_value: Number(contractValue), target_margin: Number(targetMargin),
          risk_score: finalScore, status: "completed", analysis
        });
        dispatchAuditsUpdated();
      }

      setResult({ ...analysis, risk_score: finalScore, project_name: projectName, contract_value: Number(contractValue), target_margin: Number(targetMargin) });
    } catch (e: any) { setError(e.message); } finally { setLoading(false); }
  };

  return (
    <div className="max-w-5xl mx-auto">
      <div className="page-header">
        <h1 className="page-title uppercase tracking-tighter">Bid Audit Engine</h1>
        <p className="page-subtitle uppercase font-black text-[10px] tracking-widest">Forensic AI v2.5</p>
      </div>

      {result ? (
        <ResultsPanel result={result} onReset={() => {setResult(null); setFiles([]); setProjectName("");}} />
      ) : (
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-10">
          <div className="lg:col-span-7 bg-white border border-slate-200 rounded p-8 space-y-6 shadow-sm">
            <div><label className="section-label">Project Name</label><input className="field-input" value={projectName} onChange={e => setProjectName(e.target.value)} /></div>
            <div>
              <label className="section-label">Source Docs</label>
              <input type="file" ref={fileInputRef} className="hidden" multiple onChange={e => e.target.files && setFiles([...Array.from(e.target.files)])} />
              <div onClick={() => fileInputRef.current?.click()} className="dropzone"><p className="text-[10px] font-black text-slate-400">UPLOAD PACK</p></div>
              <div className="mt-2 space-y-1">{files.map((f, i) => <div key={i} className="text-[10px] font-bold bg-slate-50 p-2 border rounded flex justify-between"><span>{f.name}</span><X size={12} className="cursor-pointer" onClick={()=>setFiles(files.filter((_,idx)=>idx!==i))}/></div>)}</div>
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div><label className="section-label">Value (ETB)</label><input type="number" className="field-input" value={contractValue} onChange={e => setContractValue(e.target.value)} /></div>
              <div><label className="section-label">Margin %</label><input type="number" className="field-input" value={targetMargin} onChange={e => setTargetMargin(e.target.value)} /></div>
            </div>
            <button onClick={runAudit} disabled={loading} className="btn-primary w-full py-4 justify-center">
              {loading ? <Loader2 className="animate-spin" size={18} /> : "Execute Forensic Audit"}
            </button>
          </div>
          <div className="lg:col-span-5 bg-slate-900 rounded-lg p-8 text-white space-y-6">
             <img src={logo} style={{ height: "30px", filter: "brightness(0) invert(1)" }} />
             <div className="space-y-4">
                <div className="flex gap-3"><Calculator size={18} className="text-blue-400"/><p className="text-[11px] text-slate-400">Forensic BoQ validation.</p></div>
                <div className="flex gap-3"><ShieldAlert size={18} className="text-blue-400"/><p className="text-[11px] text-slate-400">Legal Triage.</p></div>
             </div>
          </div>
        </div>
      )}
    </div>
  );
}
