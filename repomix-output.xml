  .btn-ghost {
    background: transparent;
    color: #6B7280;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    padding: 0.375rem 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .btn-ghost:hover { background: #F3F4F6; color: #0D1117; border-color: #E4E7EC; }

  /* ── Data table ──────────────────────────────────────────────────────── */
  .data-table {
    width: 100%;
    font-size: 0.8125rem;
    border-collapse: collapse;
  }
  .data-table thead tr {
    background: #F7F8FA;
