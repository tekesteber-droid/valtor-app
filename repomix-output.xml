    | "/"
    | "/auth"
    | "/audit"
    | "/dashboard"
    | "/history"
    | "/tender-feed";
  fileRoutesByTo: FileRoutesByTo;
  to: "/" | "/auth" | "/audit" | "/dashboard" | "/history" | "/tender-feed";
  id:
    | "__root__"
    | "/"
