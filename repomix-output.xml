<file path="src/styles.css">
@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --radius-sm: calc(var(--radius) - 2px);
  --radius-md: var(--radius);
  --radius-lg: calc(var(--radius) + 2px);
  --radius-xl: calc(var(--radius) + 4px);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-success: var(--success);
  --color-warning: var(--warning);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
}

:root {
  --radius: 0.375rem;

  /* Valtor Brand — Deep slate infrastructure platform */
  --background: #F7F8FA;
  --foreground: #0D1117;

  --card: #FFFFFF;
  --card-foreground: #0D1117;
  --popover: #FFFFFF;
  --popover-foreground: #0D1117;

  --primary: #0F2240;
  --primary-foreground: #FFFFFF;
  --secondary: #EEF1F6;
  --secondary-foreground: #374151;

  --muted: #EEF1F6;
  --muted-foreground: #6B7280;

  /* Single accent — steel blue, used for CTAs and active states only */
  --accent: #1D4ED8;
  --accent-foreground: #FFFFFF;

  --destructive: #B91C1C;
  --destructive-foreground: #FFFFFF;
  --success: #15803D;
  --warning: #B45309;

  --border: #E4E7EC;
  --input: #FFFFFF;
  --ring: rgba(15, 34, 64, 0.15);

  --shadow-xs: 0 1px 2px rgba(0,0,0,0.04);
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 4px 8px rgba(0,0,0,0.06), 0 2px 4px rgba(0,0,0,0.04);
}

@layer base {
  * {
    border-color: var(--color-border);
    box-sizing: border-box;
  }

  html, body, #root {
    min-height: 100%;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 14px;
    line-height: 1.5;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: "Inter", system-ui, sans-serif;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  input, textarea, select {
    font-family: inherit;
    font-size: inherit;
  }
}

@layer components {
  /* ── Core panel ─────────────────────────────────────────────────────── */
  .panel {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  /* ── Form inputs ─────────────────────────────────────────────────────── */
  .field-input {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: var(--radius-sm);
    color: #0D1117;
    padding: 0.5rem 0.75rem;
    width: 100%;
    font-size: 0.875rem;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .field-input:focus {
    border-color: #0F2240;
    box-shadow: 0 0 0 3px rgba(15, 34, 64, 0.1);
    outline: none;
  }
  .field-input::placeholder {
    color: #9CA3AF;
  }

  /* ── Buttons ─────────────────────────────────────────────────────────── */
  .btn-primary {
    background: #0F2240;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid #0F2240;
    padding: 0.5rem 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease;
    white-space: nowrap;
  }
  .btn-primary:hover { background: #0A1929; border-color: #0A1929; }
  .btn-primary:disabled { opacity: 0.45; cursor: not-allowed; }

  .btn-secondary {
    background: #FFFFFF;
    color: #374151;
    font-weight: 500;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid #D1D5DB;
    padding: 0.5rem 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease;
    white-space: nowrap;
  }
  .btn-secondary:hover { background: #F9FAFB; border-color: #9CA3AF; }
  .btn-secondary:disabled { opacity: 0.45; cursor: not-allowed; }

  .btn-accent {
    background: #1D4ED8;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
