              {loading ? (
                <div style={{ padding: "28px", textAlign: "center", color: "#94A3B8", fontSize: 12 }}>Loading pipeline…</div>
              ) : audits.length === 0 ? (
                <div style={{ padding: "40px 24px", textAlign: "center", color: "#94A3B8", fontSize: 12 }}>
