            ].map(k => (
              <StaggerItem key={k.label}>
                <div style={{ ...card, padding: "14px 16px" }}>
                  <div style={{ fontSize: 10, textTransform: "uppercase" as const, letterSpacing: "0.8px", color: "#94A3B8", marginBottom: 6 }}>{k.label}</div>
