// ─── Resource Gap Chart ───────────────────────────────────────────────────────

function ResourceGapChart({ analysis }: { analysis: any }) {
  const gaps = [
    { name: "Excavators", required: 10, listed: analysis?.plant_capacity ? 7 : 4 },
    { name: "Operators", required: 20, listed: analysis?.plant_capacity ? 16 : 10 },
    { name: "Trucks", required: 12, listed: analysis?.plant_capacity ? 9 : 6 },
    { name: "Engineers", required: 8, listed: analysis?.plant_capacity ? 7 : 5 },
  ];
  const data = gaps.map(g => ({
    name: g.name, required: g.required, gap: Math.max(0, g.required - g.listed),
    listed: g.listed,
  }));
  return (
    <ResponsiveContainer width="100%" height={130}>
      <BarChart data={data} layout="vertical" margin={{ left: 60, right: 8, top: 4, bottom: 4 }}>
        <XAxis type="number" tick={{ fontSize: 9, fill: "#556070" }} />
        <YAxis dataKey="name" type="category" tick={{ fontSize: 9, fill: "#8B9BAD" }} width={56} />
        <Tooltip
          contentStyle={{ background: "#1A2332", border: "1px solid rgba(255,255,255,0.1)", fontSize: 10 }}
        />
        <Bar dataKey="listed" name="Listed in Bid" fill="#1D6FE8" stackId="a" radius={[0, 0, 0, 0]} />
        <Bar dataKey="gap" name="Gap (Missing)" fill="#EF4444" stackId="a" radius={[0, 3, 3, 0]} />
      </BarChart>
    </ResponsiveContainer>
  );
}

// ─── What-If Slider Panel ─────────────────────────────────────────────────────

function WhatIfPanel({ totalValue }: { totalValue: number }) {
  const [margin, setMargin] = useState(15);
  const [cementHike, setCementHike] = useState(0);
  const [stressActive, setStressActive] = useState(false);

  const cementShare = 0.22;
  const adjustedMargin = Math.max(0, margin - cementHike * cementShare / 100 * margin);
  const projectedNet = Math.round(totalValue * adjustedMargin / 100);

  const netColor = adjustedMargin > 10 ? "#10B981" : adjustedMargin > 6 ? "#F59E0B" : "#EF4444";

  const triggerStress = () => {
    setStressActive(!stressActive);
    if (!stressActive) setCementHike(20);
    else setCementHike(0);
  };

  return (
    <div style={{ padding: "10px 14px" }}>
      <div style={{ marginBottom: 10 }}>
        <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 4 }}>
          <div style={{ fontSize: 10, color: "#8B9BAD" }}>Target Margin %</div>
          <div style={{ fontFamily: "monospace", fontSize: 11, color: "#06B6D4", fontWeight: 700 }}>{margin}%</div>
        </div>
        <input type="range" min={5} max={30} value={margin} step={1}
          onChange={e => setMargin(Number(e.target.value))}
          style={{ width: "100%", accentColor: "#1D6FE8" }} />
      </div>
      <div style={{ marginBottom: 10 }}>
        <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 4 }}>
          <div style={{ fontSize: 10, color: "#8B9BAD" }}>Cement Price Hike %</div>
          <div style={{ fontFamily: "monospace", fontSize: 11, color: cementHike > 15 ? "#EF4444" : "#06B6D4", fontWeight: 700 }}>{cementHike}%</div>
        </div>
        <input type="range" min={0} max={50} value={cementHike} step={5}
          onChange={e => setCementHike(Number(e.target.value))}
          style={{ width: "100%", accentColor: "#EF4444" }} />
      </div>
      <div style={{
        background: "#1A2332", border: "1px solid rgba(255,255,255,0.07)", borderRadius: 4,
        padding: "8px 12px", display: "flex", justifyContent: "space-between", alignItems: "center",
        marginBottom: 8,
      }}>
        <div>
          <div style={{ fontSize: 9, color: "#556070", textTransform: "uppercase", letterSpacing: "0.8px" }}>Adjusted Margin</div>
          <div style={{ fontFamily: "monospace", fontSize: 14, fontWeight: 700, color: netColor }}>
            {adjustedMargin.toFixed(1)}%
          </div>
        </div>
        <div style={{ textAlign: "right" }}>
          <div style={{ fontSize: 9, color: "#556070", textTransform: "uppercase", letterSpacing: "0.8px" }}>Net Projected</div>
          <div style={{ fontFamily: "monospace", fontSize: 14, fontWeight: 700, color: netColor }}>
            +{fmtEtb(projectedNet)} ETB
          </div>
        </div>
      </div>
      <button
        onClick={triggerStress}
        style={{
          display: "flex", alignItems: "center", gap: 6, width: "100%",
          background: stressActive ? "rgba(239,68,68,0.2)" : "rgba(239,68,68,0.08)",
          border: `1px solid ${stressActive ? "rgba(239,68,68,0.6)" : "rgba(239,68,68,0.25)"}`,
          color: "#EF4444", fontSize: 10, fontWeight: 700, letterSpacing: "0.5px",
          padding: "7px 10px", borderRadius: 4, cursor: "pointer", textTransform: "uppercase",
        }}
      >
        <Flame size={12} /> Simulate 20% Cement Price Hike
      </button>
      {stressActive && (
        <div style={{ marginTop: 6, padding: "8px 10px", background: "rgba(239,68,68,0.08)", border: "1px solid rgba(239,68,68,0.2)", borderRadius: 4, fontSize: 10, color: "#EF4444", lineHeight: 1.5 }}>
          ⚠ Margin collapses from {margin}% → {adjustedMargin.toFixed(1)}%. Projects with margin &lt;8% turn unprofitable. Director sign-off required.
        </div>
      )}
    </div>
  );
}

