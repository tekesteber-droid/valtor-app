  --color-success: var(--success);
  --color-warning: var(--warning);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
}

:root {
  --radius: 0.375rem;

  /* Valtor Brand — Deep slate infrastructure platform */
  --background: #F7F8FA;
  --foreground: #0D1117;

  --card: #FFFFFF;
  --card-foreground: #0D1117;
  --popover: #FFFFFF;
  --popover-foreground: #0D1117;

  --primary: #0F2240;
  --primary-foreground: #FFFFFF;
  --secondary: #EEF1F6;
  --secondary-foreground: #374151;

  --muted: #EEF1F6;
  --muted-foreground: #6B7280;

  /* Single accent — steel blue, used for CTAs and active states only */
  --accent: #1D4ED8;
  --accent-foreground: #FFFFFF;

  --destructive: #B91C1C;
  --destructive-foreground: #FFFFFF;
  --success: #15803D;
  --warning: #B45309;

  --border: #E4E7EC;
  --input: #FFFFFF;
  --ring: rgba(15, 34, 64, 0.15);

  --shadow-xs: 0 1px 2px rgba(0,0,0,0.04);
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 4px 8px rgba(0,0,0,0.06), 0 2px 4px rgba(0,0,0,0.04);
}

@layer base {
  * {
    border-color: var(--color-border);
    box-sizing: border-box;
  }

  html, body, #root {
    min-height: 100%;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 14px;
    line-height: 1.5;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: "Inter", system-ui, sans-serif;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  input, textarea, select {
    font-family: inherit;
    font-size: inherit;
  }
}

@layer components {
  /* ── Core panel ─────────────────────────────────────────────────────── */
  .panel {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  /* ── Form inputs ─────────────────────────────────────────────────────── */
  .field-input {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: var(--radius-sm);
    color: #0D1117;
    padding: 0.5rem 0.75rem;
    width: 100%;
    font-size: 0.875rem;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .field-input:focus {
    border-color: #0F2240;
    box-shadow: 0 0 0 3px rgba(15, 34, 64, 0.1);
    outline: none;
  }
  .field-input::placeholder {
    color: #9CA3AF;
  }

  /* ── Buttons ─────────────────────────────────────────────────────────── */
  .btn-primary {
    background: #0F2240;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid #0F2240;
    padding: 0.5rem 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease;
    white-space: nowrap;
  }
  .btn-primary:hover { background: #0A1929; border-color: #0A1929; }
  .btn-primary:disabled { opacity: 0.45; cursor: not-allowed; }

  .btn-secondary {
    background: #FFFFFF;
    color: #374151;
    font-weight: 500;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid #D1D5DB;
    padding: 0.5rem 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease;
    white-space: nowrap;
  }
  .btn-secondary:hover { background: #F9FAFB; border-color: #9CA3AF; }
  .btn-secondary:disabled { opacity: 0.45; cursor: not-allowed; }

  .btn-accent {
    background: #1D4ED8;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid #1D4ED8;
    padding: 0.5rem 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    transition: background 0.12s ease;
    white-space: nowrap;
  }
  .btn-accent:hover { background: #1A44C5; }
  .btn-accent:disabled { opacity: 0.45; cursor: not-allowed; }

  .btn-ghost {
    background: transparent;
    color: #6B7280;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    padding: 0.375rem 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .btn-ghost:hover { background: #F3F4F6; color: #0D1117; border-color: #E4E7EC; }

  /* ── Data table ──────────────────────────────────────────────────────── */
  .data-table {
    width: 100%;
    font-size: 0.8125rem;
    border-collapse: collapse;
  }
  .data-table thead tr {
    background: #F7F8FA;
    border-bottom: 1px solid #E4E7EC;
  }
  .data-table thead th {
    text-align: left;
    padding: 0.625rem 1rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #6B7280;
    white-space: nowrap;
  }
  .data-table thead th.text-right { text-align: right; }
  .data-table tbody tr {
    border-bottom: 1px solid #F3F4F6;
    transition: background 0.08s ease;
  }
  .data-table tbody tr:hover { background: #FAFBFC; }
  .data-table tbody td {
    padding: 0.75rem 1rem;
    color: #111827;
    vertical-align: middle;
  }
  .data-table tbody td.text-right { text-align: right; }
  .data-table tbody td.muted { color: #6B7280; }

  /* ── Status badges ───────────────────────────────────────────────────── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .badge-green  { background: #F0FDF4; color: #15803D; border-color: #BBF7D0; }
  .badge-red    { background: #FEF2F2; color: #B91C1C; border-color: #FECACA; }
  .badge-amber  { background: #FFFBEB; color: #B45309; border-color: #FDE68A; }
  .badge-blue   { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; }
  .badge-slate  { background: #F8FAFC; color: #475569; border-color: #CBD5E1; }
  .badge-navy   { background: #EFF3FA; color: #0F2240; border-color: #C3CEDF; }

  /* ── Page header ─────────────────────────────────────────────────────── */
  .page-header {
    margin-bottom: 1.5rem;
  }
  .page-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: #0D1117;
    letter-spacing: -0.025em;
  }
  .page-subtitle {
    font-size: 0.8125rem;
    color: #6B7280;
    margin-top: 0.25rem;
  }

  /* ── Section label ───────────────────────────────────────────────────── */
  .section-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #6B7280;
    margin-bottom: 0.5rem;
  }

  /* ── Stat card ───────────────────────────────────────────────────────── */
  .stat-card {
    background: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }
  .stat-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #6B7280;
    margin-bottom: 0.5rem;
  }
  .stat-value {
    font-size: 1.625rem;
    font-weight: 700;
    color: #0D1117;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .stat-delta {
    font-size: 0.75rem;
    color: #6B7280;
    margin-top: 0.375rem;
  }

  /* ── Risk score ring ─────────────────────────────────────────────────── */
  .risk-low    { color: #15803D; }
  .risk-medium { color: #B45309; }
  .risk-high   { color: #B91C1C; }

  /* ── Divider ─────────────────────────────────────────────────────────── */
  .divider {
    border: none;
    border-top: 1px solid #E4E7EC;
    margin: 1.5rem 0;
  }

  /* ── File queue row ──────────────────────────────────────────────────── */
  .file-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid #F3F4F6;
  }
  .file-row:last-child { border-bottom: none; }
  .file-row:nth-child(odd) { background: #FAFBFC; }
  .file-row:nth-child(even) { background: #FFFFFF; }

  /* ── Dropzone ────────────────────────────────────────────────────────── */
  .dropzone {
    border: 1.5px dashed #D1D5DB;
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease;
    background: #FAFBFC;
  }
  .dropzone:hover, .dropzone.active {
    border-color: #0F2240;
    background: #F0F3F8;
  }

  /* ── Sidebar nav ─────────────────────────────────────────────────────── */
  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #6B7280;
    text-decoration: none;
    transition: background 0.1s ease, color 0.1s ease;
    white-space: nowrap;
  }
  .nav-link:hover { background: #F3F4F6; color: #0D1117; }
  .nav-link.active {
    background: #EEF1F6;
    color: #0F2240;
    font-weight: 600;
    border-left: 2px solid #0F2240;
    padding-left: calc(0.875rem - 2px);
  }

  /* ── Empty state ─────────────────────────────────────────────────────── */
  .empty-state {
    padding: 3.5rem 2rem;
    text-align: center;
    color: #9CA3AF;
  }
  .empty-state p { font-size: 0.875rem; margin-top: 0.5rem; }
}

/* ── Landing page utilities (merged from marketing site) ────────────────── */
@utility grid-bg {
  background-image:
    linear-gradient(to right, rgba(228, 231, 236, 0.6) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(228, 231, 236, 0.6) 1px, transparent 1px);
  background-size: 40px 40px;
}

@utility label-xs {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
}
